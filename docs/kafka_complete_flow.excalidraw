      "frameId": null,
      "groupIds": [],
      "index": "b0v",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Registers, versions, and serves the Avro StatusMessage schema to Avro serializers/deserializers (Producer #2, WarningApp, BaseStationConsumer).\nPersists registered schemas back inside Apache Kafka via SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS=kafka:9092 (_schemas topic). Bypassed by Producer #1 & Producer #3 (byte[]).",
      "roughness": 1,
      "roundness": null,
      "seed": 1104762325,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Registers, versions, and serves the Avro StatusMessage schema to Avro serializers/deserializers (Producer #2, WarningApp, BaseStationConsumer).\nPersists registered schemas back inside Apache Kafka via SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS=kafka:9092 (_schemas topic). Bypassed by Producer #1 & Producer #3 (byte[]).",
      "textAlign": "left",
      "updated": 1795695499791,
      "version": 1,
      "versionNonce": 286540809,
      "verticalAlign": "top"
    },
