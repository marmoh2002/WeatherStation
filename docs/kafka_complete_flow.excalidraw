    {
      "id": "p1-body",
      "type": "text",
      "x": 72,
      "y": 248,
      "width": 352,
      "height": 178,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 12.5,
      "frameId": null,
      "groupIds": [],
      "index": "aK",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "1. Check STATION_ID env override\n   (AppConfigs.parseStationIdOverride):\n   if >= 0 -> skip Kafka & use ID immediately\n2. Else AdminClient creates/verifies\n   weather-station-ids (1 part, retention=-1;\n   ignores TopicExistsException)\n3. Producer #1 (Coordination Producer):\n   • KafkaProducer<byte[], byte[]> (no Registry)\n   • acks=all, enable.idempotence=true\n   • Sends 1 marker (UUID, timestamp) to part 0\n   • Retries 5x (1s backoff) -> id = offset + 1",
      "roughness": 1,
      "roundness": null,
      "seed": 350382741,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "1. Check STATION_ID env override\n   (AppConfigs.parseStationIdOverride):\n   if >= 0 -> skip Kafka & use ID immediately\n2. Else AdminClient creates/verifies\n   weather-station-ids (1 part, retention=-1;\n   ignores TopicExistsException)\n3. Producer #1 (Coordination Producer):\n   • KafkaProducer<byte[], byte[]> (no Registry)\n   • acks=all, enable.idempotence=true\n   • Sends 1 marker (UUID, timestamp) to part 0\n   • Retries 5x (1s backoff) -> id = offset + 1",
      "textAlign": "left",
      "updated": 1795695499783,
      "version": 1,
      "versionNonce": 517148899,
      "verticalAlign": "top"
    },
