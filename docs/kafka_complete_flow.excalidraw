      "groupIds": [],
      "index": "aQ",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "• Producer #2: Producer.createProducer()\n  KafkaProducer<Long, StatusMessage>\n  (client.id = ProducerApp)\n• Key: LongSerializer (key = station_id)\n• Val: KafkaAvroSerializer -> Registry :8081\n• ProducerLoop emits 1 reading / 1s\n  (10% simulated packet drop -> s_no gap)\n• Sets station_id in BOTH Kafka record key\n  and StatusMessage.station_id\n• Weather: humidity 20-100%, temp 30-110 F,\n  wind 0-50 km/h, battery {low, med, high}",
      "roughness": 1,
      "roundness": null,
      "seed": 1457556494,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "• Producer #2: Producer.createProducer()\n  KafkaProducer<Long, StatusMessage>\n  (client.id = ProducerApp)\n• Key: LongSerializer (key = station_id)\n• Val: KafkaAvroSerializer -> Registry :8081\n• ProducerLoop emits 1 reading / 1s\n  (10% simulated packet drop -> s_no gap)\n• Sets station_id in BOTH Kafka record key\n  and StatusMessage.station_id\n• Weather: humidity 20-100%, temp 30-110 F,\n  wind 0-50 km/h, battery {low, med, high}",
      "textAlign": "left",
      "updated": 1795695499783,
      "version": 1,
      "versionNonce": 1977176056,
      "verticalAlign": "top"
    },
