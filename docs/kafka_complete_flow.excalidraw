    {
      "id": "sr-body",
      "type": "text",
      "x": 58,
      "y": 964,
      "width": 1460,
      "height": 34,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
