<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>

        <Property name="APP_NAME">my_stream</Property>        <!-- change per module -->
    </Properties>

    <Appenders>

        <!-- Console appender — always useful in Docker -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!-- Rolling file appender — useful for persistent logs -->
        <RollingFile name="FileAppender" fileName="logs/${APP_NAME}.log" filePattern="logs/${APP_NAME}-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
            <!-- keep 7 days -->
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- Silence noisy Kafka internals — set to WARN unless debugging -->
        <Logger name="org.apache.kafka" level="WARN" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
        </Logger>

        <!-- Silence noisy Confluent/Schema Registry internals -->
        <Logger name="io.confluent" level="WARN" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
        </Logger>

        <!-- Your application code — DEBUG in dev, INFO in prod -->
        <Logger name="com.my_stream" level="DEBUG" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <!-- Root catches everything else -->
        <Root level="INFO">
            <AppenderRef ref="ConsoleAppender"/>
        </Root>

    </Loggers>

</Configuration>