FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /app

# copy poms
COPY pom.xml ./pom.xml
COPY shared_model/pom.xml ./shared_model/pom.xml
COPY my_producer/pom.xml ./my_producer/pom.xml

# install root pom into .m2 first — everything depends on it
RUN mvn install -N -q

# copy and install shared_model
COPY shared_model ./shared_model
RUN cd shared_model && mvn clean install -Dmaven.test.skip=true -q

# now go-offline works — both parent and shared_model are in .m2
RUN cd my_producer && mvn dependency:go-offline -q

# copy source and build
COPY my_producer ./my_producer
RUN cd my_producer && mvn clean package -Dmaven.test.skip=true

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=builder /app/my_producer/target/my_producer-1.0-SNAPSHOT-jar-with-dependencies.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]